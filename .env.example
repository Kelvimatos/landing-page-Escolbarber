# ==============================================================================
# ESCOL BARBER — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env caso utilize variáveis em um pipeline de CI/CD
# ==============================================================================

# URL pública de produção do site (utilizado em links canônicos e tags Open Graph)
PUBLIC_SITE_URL="https://escolbarber.com.br"

# Identificador de monitoramento analítico (opcional: Google Analytics 4 / Tag Manager)
PUBLIC_GA_ID="G-XXXXXXXXXX"

# Configuração de ambiente
NODE_ENV="production"

